RewriteEngine On

# ===== Hide .php extension from the address bar =====
# /cari.php (and any other bare *.php file) -> /cari in the browser, so
# links, bookmarks, and shares never show the file extension. Internal
# rewrites below (artikel/, kategori/, live/) are untouched since the
# browser never sees .php for those anyway.

# index.php specifically -> root, not /index
RewriteCond %{THE_REQUEST} \s/+index\.php[\s?] [NC]
RewriteRule ^ /? [R=301,L]

# any other *.php -> same path without the extension (query string kept)
RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# serve /cari (and similar) from cari.php internally, no visible redirect
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^([^/]+)$ $1.php [L,QSA]


# Blokir akses publik ke file/folder yang ikut ter-deploy (rsync .cpanel.yml
# nyalin semuanya) tapi tidak boleh diakses langsung lewat browser — bukan
# bagian runtime aplikasi, cuma dokumentasi/riwayat git.
RedirectMatch 404 /\.git
RedirectMatch 404 ^/docs/
RedirectMatch 404 ^/CLAUDE\.md$
RedirectMatch 404 ^/\.cpanel\.yml$

# NOTE: struktur permalink final belum dikonfirmasi operator (lihat
# docs/HANDOFF.md). Sementara pakai pola yang sama dengan wcm1_version1
# (/artikel/{slug}, /kategori/{slug}) supaya frontend bisa langsung dites —
# GANTI di sini kalau operator kasih struktur lain (misal /berita/{slug}
# atau /{kategori}/{slug}).

# /artikel/{slug} -> artikel.php?slug={slug}
RewriteRule ^artikel/([a-zA-Z0-9\-]+)/?$ artikel.php?slug=$1 [L,QSA]

# /kategori/{slug} -> kategori.php?slug={slug}
RewriteRule ^kategori/([a-zA-Z0-9\-]+)/?$ kategori.php?slug=$1 [L,QSA]

# Live streaming player (additive feature, 9 Sep 2026) — match/stream data
# fetched server-side from sagagoal.com's public API, no local DB. {slug}
# is cosmetic only, not looked up. Custom-stream rule MUST come before the
# generic /live/{id}/... rule below, or "custom" gets parsed as {id}.
# /live/custom/{id}/{slug} -> live.php?custom_id={id}&slug={slug}
RewriteRule ^live/custom/([0-9]+)/([^/]+)/?$ live.php?custom_id=$1&slug=$2 [L,QSA]

# /live/{id}/{slug} -> live.php?id={id}&slug={slug}
RewriteRule ^live/([0-9]+)/([^/]+)/?$ live.php?id=$1&slug=$2 [L,QSA]

# ===== Browser caching for static assets (images/css/js/fonts) =====
# Lets repeat visits reuse already-downloaded files from the browser's own
# cache instead of re-downloading on every reload — big win for image-heavy
# pages like the homepage hero banner + news thumbnails. Safe no-op if the
# module isn't enabled on this host (wrapped in <IfModule>).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(jpe?g|png|webp|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>
